{
  "description": "A non-numeric value in a sum column is skipped and reported as JOIN07 (row number of the detail row); the master row still joins with the sum of the numeric values, all-bad gives empty.",
  "layout": {
    "files": [
      {
        "role": "master",
        "name_pattern": "m_(?P<date>\\d{8})\\.csv",
        "key": [
          "id"
        ],
        "required": true
      },
      {
        "role": "items",
        "name_pattern": "i_(?P<date>\\d{8})\\.csv",
        "required": true
      }
    ],
    "relations": [
      {
        "detail": "items",
        "to": "master",
        "on": [
          {
            "parent": "id",
            "detail": "ref"
          }
        ],
        "normalize": [
          "trim"
        ],
        "cardinality": "many",
        "mode": "aggregate",
        "on_missing_detail": "allow",
        "aggregate": {
          "columns": [
            {
              "as": "total",
              "op": "sum",
              "col": "amt"
            },
            {
              "as": "n",
              "op": "count"
            }
          ]
        }
      }
    ]
  },
  "files": {
    "master": "master.csv",
    "items": "details.csv"
  },
  "parse_options": {},
  "expected_rows": "expected.csv",
  "expected_exceptions": [
    {
      "code": "JOIN07",
      "role": "items",
      "row_number": 2
    },
    {
      "code": "JOIN07",
      "role": "items",
      "row_number": 4
    }
  ],
  "expected_blocked": null
}